# Quarto build output
/_site/
/.quarto/

# Generated from the pages by tools/extract-code.py on every build, and copied
# into the site as a resource. Never edit or commit it; edit the page.
/downloads/
*_files/
*_cache/

# Stray output from rendering a single .qmd outside the project context.
# Real site output goes to _site/ only; these are never wanted in the repo.
/site_libs/
chapters/**/*.html
chapters/**/index-listing.json

# R
.Rproj.user/
.Rhistory
.RData
.Ruserdata
.Renviron

# Quarto environment for this machine: which Python runs the Python tabs
_environment.local

# renv library (renv.lock is committed)
renv/library/
renv/staging/
renv/python/
renv/sandbox/

# Python (the snippet checker imports python/mlbasic_data.py)
__pycache__/
*.pyc

# OS
.DS_Store
Thumbs.db

**/*.quarto_ipynb

# Video pipeline output (the scripts and code in _videos/ and tools/ are committed)
_videos/*/audio/
_videos/*/visuals/
_videos/*/rough-cut.mp4
_videos/*/captions.srt
# Videos and recorded audio stay local, whatever they are called; they are large.
# The intro music is the one exception: the pipeline needs it and it is small.
_videos/**/*.mp4
_videos/**/*.mov
_videos/**/*.mkv
_videos/**/*.webm
_videos/**/*.wav
_videos/**/*.mp3
!_videos/intro-music.wav
_videos/*/chapters.txt

/_*.local
